#!/usr/bin/env perl

# Translate and MS Access file into a (set of) CSV file(s)
 
use strict;
use warnings;
use autodie qw(:all);

use Getopt::Long qw(GetOptions);
use Pod::Usage qw(pod2usage);
use IPC::Run3 qw(run3);
use File::Spec;
use File::Path qw(make_path);
 
=head1 NAME
 
access2csv - Export Access tables to CSV files
 
=head1 SYNOPSIS
 
accdb_to_csv.pl [options] database.accdb
 
 Options:
   --output-dir DIR
   --table TABLE
   --overwrite
   --verbose
   --help
   --man
 
=head1 EXAMPLES
 
Export all tables:
 
  perl accdb_to_csv.pl music.accdb
 
Export to a specific directory:
 
  perl accdb_to_csv.pl \
	  --output-dir exports \
	  music.accdb
 
Export one table:
 
  perl accdb_to_csv.pl \
	  --table Members \
	  music.accdb
 
Export multiple tables:
 
  perl accdb_to_csv.pl \
	  --table Members \

=cut

my %opt = (
	output_dir => '.',
	overwrite  => 0,
	verbose	=> 0,
);
 
GetOptions(
	'output-dir=s' => \$opt{output_dir},
	'table=s@'	 => \$opt{table},
	'overwrite!'   => \$opt{overwrite},
	'verbose!'	 => \$opt{verbose},
	'help|h'	   => sub { pod2usage(1) },
	'man'		  => sub { pod2usage( -verbose => 2 ) },
) or pod2usage(2);
 
my $database = shift @ARGV
	or pod2usage(
		-message => 'Missing .accdb filename',
		-exitval => 2
	);
 
-f $database
	or die "Database file does not exist: $database\n";
 
main();
 
sub main {
 
	create_output_dir( $opt{output_dir} );
 
	my @tables = get_tables($database);
 
	if ( $opt{table} ) {
 
		my %wanted = map { $_ => 1 } @{ $opt{table} };
 
		@tables = grep { $wanted{$_} } @tables;
 
		die "None of the requested tables were found\n"
			unless @tables;
	}
 
	verbose("Found " . scalar(@tables) . " table(s)");
 
	my $failures = 0;
 
	foreach my $table (@tables) {
 
		eval {
			export_table(
				database   => $database,
				table	  => $table,
				output_dir => $opt{output_dir},
				overwrite  => $opt{overwrite},
			);
 
			1;
		} or do {
 
			my $error = $@ || 'Unknown error';
 
			warn "Failed to export '$table': $error";
 
			++$failures;
		};
	}
 
	verbose('Export complete');
 
	exit $failures ? 1 : 0;
}
 
sub get_tables {
 
	my ($db) = @_;
 
	my ( $stdout, $stderr );
 
	run3(
		[ 'mdb-tables', '-1', $db ],
		undef,
		\$stdout,
		\$stderr,
	);
 
	die "mdb-tables failed:\n$stderr\n"
		if $?;
 
	my @tables = grep { length }
				 map  { chomp; $_ }
				 split /\n/, $stdout;
 
	return @tables;
}
 
sub export_table {
 
	my %arg = @_;
 
	my $table = $arg{table};
 
	my $outfile = File::Spec->catfile(
		$arg{output_dir},
		"$table.csv"
	);
 
	if ( -e $outfile && !$arg{overwrite} ) {
 
		die "Output file already exists: $outfile\n";
	}
 
	verbose("Exporting $table");
 
	my ( $stdout, $stderr );
 
	run3(
		[
			'mdb-export',
			$arg{database},
			$table,
		],
		undef,
		\$stdout,
		\$stderr,
	);
 
	die "mdb-export failed for '$table':\n$stderr\n"
		if $?;
 
	open my $fh, '>:encoding(UTF-8)', $outfile;
 
	print {$fh} $stdout;
 
	close $fh;
 
	verbose("Created $outfile");
}
 
sub create_output_dir {
 
	my ($dir) = @_;
 
	return if -d $dir;
 
	make_path($dir);
}
 
sub verbose {
 
	my ($msg) = @_;
 
	return unless $opt{verbose};
 
	print "[INFO] $msg\n";
}
 
__END__
