# sshmonitor 0.5
# Deny persistent attempts at cracking a site with ssh
#
# 13/5/05:	Catch entries such as Failed password for root from
# 29/5/05:	Better wait algorithm
# 23/12/05:	Don't add sites that are listed in /etc/hosts.allow
#
# Install in /usr/local/sbin/sshmonitor and start thus (in /etc/rc.local):
#	/usr/local/sbin/sshmonitor >> /var/log/secure 2>&1 &
# though it would be better to use syslog
# TODO: use File::Tail

use strict;
use IO::Handle;
use NetAddr::IP;

my $log = '/var/log/secure';	# Red Hat/Fedora (auth.log on Debian)
my $deny = '/etc/hosts.deny';
my $allow = '/etc/hosts.deny';
my $checktime = 5;	# How often to check $log
my $localnet = new NetAddr::IP("192.168.1.0/24");
my $triggerlevel = 5;	# Grace login failures that we allow

open(LOG, "<$log") or die "$log: $!\n";

my %blacklist = ();

for(;;) {
	my $ip;
	my $anynew = 0;

	LOGLINE: while(<LOG>) {
		if((/: Invalid user .+ from (.+)\n/) ||
		   (/: Failed password for .+ from (.+?)\s.+\n/)) {
			next LOGLINE if($1 =~ /^127.0.0./);

			my $me = new NetAddr::IP($1);

			next LOGLINE if($me->within($localnet));

			$ip = $1;

			open(DENY, "<$deny") or die "$deny: $!\n";
			foreach(<DENY>) {
				if(/$ip/) {
					close DENY;
					delete $blacklist{$ip};
					next LOGLINE;
				}
			}
			close(DENY);
			$anynew = 1;
			$blacklist{$ip}++;
		}

	}
	if($anynew) {
		my $count;

		open(ALLOW, "<$allow") or die "$allow: $!\n";
		ALLOWLINE: foreach(<ALLOW>) {
			my $line = $_;
			while(($ip, $count) = each(%blacklist)) {
				if($line =~ /^(all|sshd):.*$ip/i) {
					print "$ip NOT added (" . $count . " attempts)\n";
					delete $blacklist{$ip};
					next ALLOWLINE;
				}
			}
		}
		close ALLOW;

		open(DENY, ">>$deny") or die "$deny: $!\n";
		while(($ip, $count) = each(%blacklist)) {
			if($count >= $triggerlevel) {
				print DENY "sshd: $ip\n";
				print "Added $ip (" . $count . " attempts)\n";
				delete $blacklist{$ip};
			}
		}
		close(DENY);
	}
	my $size = -s $log;
	do {
		sleep $checktime;
	} while($size == -s $log);

	LOG->clearerr();
}
